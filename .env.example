# Скопіюй у .env.local і заповни значеннями з Supabase → Project Settings → API Keys.
# EXPO_PUBLIC_* потрапляють у бандл застосунку, тож тут лише публічні значення.
# Секретний ключ (sb_secret_… / service_role) сюди не клади ніколи.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Web client ID потрібен на всіх платформах (з ним Google видає ID-токен для Supabase).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=....apps.googleusercontent.com
# iOS client ID — лише для iOS-збірки; з нього app.config.ts збирає iosUrlScheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=....apps.googleusercontent.com
