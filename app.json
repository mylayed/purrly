{
  "expo": {
    "name": "Purrly",
    "slug": "purrly",
    "owner": "mylayed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "purrly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mylayed.purrly",
      "usesAppleSignIn": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.mylayed.purrly",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Purrly uses your photos so you can set a profile picture and add photos of your cats.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8875B",
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d34cd19b-ff44-4298-bfc9-2275c4a89c48"
      }
    }
  }
}
